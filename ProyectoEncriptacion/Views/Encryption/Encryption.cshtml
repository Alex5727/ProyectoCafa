<h2>Cifrado AES-256 GCM</h2>

<form asp-action="Index" method="post">
    <div class="form-group mb-3">
        <label for="InputText" class="form-label">Ingresa un texto a :</label>
        <textarea id="InputText"
                  name="InputText"
                  rows="4"
                  class="form-control"
                  placeholder="Pega aquí el texto a cifrar">@Model.InputText</textarea>
    </div>
    <button type="submit" class="btn btn-primary">
        Encriptar
    </button>
</form>

@if (!string.IsNullOrEmpty(Model.OutputText))
{
    <div class="mt-4">
        <label class="form-label">Texto encriptado:</label>
        <textarea class="form-control"
                  rows="4"
                  readonly>@Model.OutputText</textarea>
    </div>
}