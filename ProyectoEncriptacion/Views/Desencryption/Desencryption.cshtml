@model TextModel

<h2 class="mb-4">Desencriptar AES-256 GCM</h2>

<form asp-action="Index" method="post" class="mb-4">
    <div class="form-group mb-3">
        <label for="InputText" class="form-label">Ingresa un texto encriptado (AES-GCM, Base64):</label>
        <textarea id="InputText"
                  name="InputText"
                  rows="4"
                  class="form-control"
                  placeholder="Pega aquí el texto cifrado">@Model.InputText</textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        Desencriptar
    </button>
</form>

@if (Model != null && !string.IsNullOrEmpty(Model.DecryptedText))
{
    <div class="mt-4">
        <label class="form-label">Texto desencriptado:</label>
        <textarea class="form-control"
                  rows="4"
                  readonly>@Model.DecryptedText</textarea>
    </div>
}
