@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto Seguridad</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoEncriptacion.styles.css" asp-append-version="true" />

    <style>
        body {
            background: linear-gradient(135deg, #0d1117, #1b1f24);
            color: #e6e6e6;
            min-height: 100vh;
        }

        .navbar-custom {
            backdrop-filter: blur(8px);
            background: rgba(0, 0, 0, 0.55) !important;
        }

        .nav-link {
            font-weight: 500;
            color: #b5e853 !important;
        }

        .nav-link:hover {
            color: #d6ff7e !important;
        }

        .content-wrapper {
            background: rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            padding: 25px;
            margin-top: 20px;
            box-shadow: 0 0 12px rgba(0, 0, 0, 0.3);
        }

        footer {
            margin-top: 40px;
            padding: 15px 0;
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-custom border-bottom mb-3 shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand text-white fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    Seguridad OWASP
                </a>

                <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Encryption" asp-action="Index">Encriptar</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Desencryption" asp-action="Index">Desencriptar</a>
                        </li>

                    </ul>

                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-flex">
                        <button type="submit" class="btn btn-outline-light px-3">
                            Salir
                        </button>
                    </form>

                </div>

            </div>
        </nav>
    </header>


    <div class="container">
        <div class="content-wrapper">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>


    <footer class="text-center text-muted">
        <div class="container">
            &copy; 2025 - ProyectoEncriptacion -
            <a class="text-decoration-none text-info" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
