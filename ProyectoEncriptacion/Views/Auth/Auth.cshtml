@{
    ViewData["Title"] = "Auth";

    Layout = null;
}
@Html.AntiForgeryToken()
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NeonEncryption</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            /* Tu color de fondo base (negro) */
            background-color: #0d0d0d !important;
            color: #e0e0e0;
            /* Para centrar el formulario de login horizontal y verticalmente */
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 0;
        }

        /* CLASES ESPECÍFICAS DE LOGIN */
        .login-card-blur {
            background-color: rgba(30, 30, 30, 0.9);
            border: 1px solid #333;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
        }

        /* ESTILOS DEL LOGO */
        .logo-header img {
            height: auto;
            width: auto;
        }

        .logo-text {
            font-size: 1.5rem;
            line-height: 1;
        }

        /* AJUSTES PARA QUE LOS INPUTS COMBINEN CON EL TEMA OSCURO */
        .form-control {
            background-color: #252525 !important;
            border: 1px solid #444 !important;
            color: #e0e0e0 !important;
        }

            .form-control:focus {
                border-color: #a2dd39 !important; /* Verde Neón de enfoque */
                box-shadow: 0 0 0 0.25rem rgba(162, 221, 57, 0.25) !important;
            }

        /* Ajuste de Checkbox para tema oscuro */
        .form-check-input {
            background-color: #252525;
            border-color: #444;
        }

            .form-check-input:checked {
                background-color: #a2dd39;
                border-color: #a2dd39;
            }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body>
    <div class="login-container">
        <div class="container" style="max-width: 420px;">

            <div class="card login-card-blur rounded p-4 p-md-5">

                <div class="d-flex align-items-center justify-content-center logo-header">
                <h2 style="color:#a2dd39;">NeonEncryption</h1>
                </div>

                <div class=" mb-3 mt-2">
                    <h2 class="h5 font-weight-bold text-light text-center">Iniciar Sesión</h2>
                    <p class="text-secondary mt-1 text-left">Accede con tu cuenta para continuar:</p>
                </div>
                <form asp-action="Login"asp-controller="Auth" method="POST">
                    <div class="mb-3">
                        <label for="text" class="form-label">Ingresar usuario:</label>
                        <input type="text" id="username" name="username" required
                               class="form-control"
                               placeholder="Usuario">
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Contraseña:</label>
                        <input type="password" id="password" name="password" required
                               class="form-control"
                               placeholder="••••••••">
                    </div>

                    @* <div class="d-flex justify-content-between align-items-center mb-4 small">
                        <div class="form-check">
                            <input id="remember-me" name="remember-me" type="checkbox"
                                   class="form-check-input">
                            <label for="remember-me" class="form-check-label text-light">Recordarme</label>
                        </div>
                        <a href="#" class="text-green text-decoration-none">¿Olvidaste tu contraseña?</a>
                    </div> *@

                    <div>
                        <button type="submit" class="btn btn-primary w-100 py-2">Iniciar Sesión</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>